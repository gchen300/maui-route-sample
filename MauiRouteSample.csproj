<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Use a MAUI framework that matches common tooling; change to net8.0-* only if your SDK/workloads support it -->
    <TargetFrameworks>net7.0-android;net7.0-ios;net7.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseMaui>true</UseMaui>
    <ApplicationTitle>MauiRouteSample</ApplicationTitle>
    <MauiUseMaps>true</MauiUseMaps>

    <!-- Set minimum Android SDK level explicitly instead of SupportedOSPlatformVersion -->
    <AndroidMinSdkVersion>21</AndroidMinSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="8.1.0" />
    <!-- Microsoft.Maui.Controls.Maps is included via the MAUI SDK when MauiUseMaps is true -->
  </ItemGroup>
</Project>
