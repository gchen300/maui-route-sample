<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseMaui>true</UseMaui>
    <ApplicationTitle>MauiRouteSample</ApplicationTitle>
    <AndroidMinSdkVersion>21</AndroidMinSdkVersion>
    <AndroidTargetSdkVersion>34</AndroidTargetSdkVersion>
  </PropertyGroup>

  <!-- Android-specific icon settings only (prevents Windows resource compiler from trying to use a PNG as an .ico) -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-android'">
    <ApplicationIcon>Resources\Images\route_app_icon.png</ApplicationIcon>
    <ApplicationDisplayIcon>Resources\Images\route_app_icon.png</ApplicationDisplayIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />
    <PackageReference Include="CommunityToolkit.Maui" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ensure the PNG is treated as a MAUI image asset for Android -->
    <MauiImage Include="Resources\Images\route_app_icon.png" />
  </ItemGroup>
</Project>
