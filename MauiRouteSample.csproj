<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Target .NET 8 MAUI frameworks (ensure your SDK/workloads support these platform versions) -->
    <TargetFrameworks>net8.0-android34.0;net8.0-ios17.2;net8.0-maccatalyst17.2</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseMaui>true</UseMaui>
    <ApplicationTitle>MauiRouteSample</ApplicationTitle>
    <MauiUseMaps>true</MauiUseMaps>

    <!-- Minimum Android SDK level -->
    <AndroidMinSdkVersion>21</AndroidMinSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- CommunityToolkit.Maui 9.x targets .NET 8 -->
    <PackageReference Include="CommunityToolkit.Maui" Version="9.0.0" />
  </ItemGroup>
</Project>
