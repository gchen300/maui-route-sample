<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiRouteSample.MainPage"
             Title="Pickup Route">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="10">
        <StackLayout Orientation="Horizontal" Spacing="8">
            <Entry x:Name="AddressEntry" Placeholder="Enter address or place" HorizontalOptions="FillAndExpand" />
            <Button Text="Add" Clicked="AddAddress_Clicked" />
        </StackLayout>

        <Label Grid.Row="1" Text="Added pickups (max 4):" FontAttributes="Bold" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout x:Name="PickupContainer" Spacing="6" />
        </ScrollView>

        <StackLayout Grid.Row="3" Orientation="Horizontal" HorizontalOptions="FillAndExpand" Spacing="10" Padding="0,8,0,0">
            <Button Text="Clear" Clicked="Clear_Clicked" />
            <Button Text="Calculate &amp; Navigate" Clicked="Calculate_Clicked" HorizontalOptions="EndAndExpand" />
        </StackLayout>
    </Grid>
</ContentPage>
